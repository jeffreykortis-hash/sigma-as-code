# Sigma Computing API credentials
# Copy this file to .env and fill in your values.
# The .env file is git-ignored and should never be committed.

# Base URL for your Sigma API region
# Example: https://aws-api.sigmacomputing.com
SIGMA_BASE_URL=https://aws-api.sigmacomputing.com

# OAuth2 client credentials (from Sigma Admin Portal > Developer Access)
SIGMA_CLIENT_ID=your_client_id_here
SIGMA_CLIENT_SECRET=your_client_secret_here
